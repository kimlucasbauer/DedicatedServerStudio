<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DedicatedServerStudio</AssemblyName>
    <RootNamespace>DedicatedServerStudio</RootNamespace>
    <Product>Dedicated Server Studio</Product>
    <Version>0.4.8</Version>
    <DssUpdaterEnabled Condition="'$(DssUpdaterEnabled)' == ''">true</DssUpdaterEnabled>
    <DefineConstants Condition="'$(DssUpdaterEnabled)' != 'false'">$(DefineConstants);DSS_UPDATER_ENABLED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- DSS runs alongside dedicated game servers; prefer a smaller managed heap over throughput. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Vite build emits the only frontend artifacts DSS serves. Keep React sources out of the web package. -->
    <Content Remove="frontend\**;publish\**;release\**;dss-config.json" />
    <None Remove="frontend\**;publish\**;release\**;dss-config.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(DssUpdaterEnabled)' == 'false'">
    <!-- Nexus excludes the automatic update client; publish.ps1 separately includes the offline ZIP helper. -->
    <Compile Remove="Services\GitHubReleaseService.cs;Services\DssUpdateProgressStore.cs" />
    <None Remove="apply-update.ps1" />
  </ItemGroup>

</Project>
