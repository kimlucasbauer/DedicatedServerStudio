<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DedicatedServerStudio</AssemblyName>
    <RootNamespace>DedicatedServerStudio</RootNamespace>
    <Product>Dedicated Server Studio</Product>
    <Version>0.3.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Vite build emits the only frontend artifacts DSS serves. Keep React sources out of the web package. -->
    <Content Remove="frontend\**;publish\**;release\**" />
    <None Remove="frontend\**;publish\**;release\**" />
  </ItemGroup>

</Project>
